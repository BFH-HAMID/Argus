recordings/
known_faces/
data/
*.log
*.db

# --- Python ----------------------------------------------------------------
__pycache__/
*.py[cod]
*.egg-info/
.venv*/
venv/
build/
dist/

# --- YOLO model downloads ---------------------------------------------------
*.pt

# --- OS / editor ------------------------------------------------------------
.DS_Store
Thumbs.db
.idea/
.vscode/
