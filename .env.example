# ============================================================================
# Argus Enterprise CCTV AI Security System - Environment variables
# Copy this file to `.env` and fill in your real values.  `.env` is git-ignored.
# ============================================================================

# --- Telegram Bot (get token from @BotFather, chat id from @userinfobot) ---
TELEGRAM_TOKEN=YOUR_TELEGRAM_BOT_TOKEN
TELEGRAM_CHAT_ID=YOUR_CHAT_ID

# --- Camera RTSP streams (one per camera id used in config.py) ---
CAM_01_URL=rtsp://user:pass@192.168.1.101:554/stream1
CAM_02_URL=rtsp://user:pass@192.168.1.102:554/stream1
CAM_03_URL=rtsp://user:pass@192.168.1.103:554/stream1
CAM_04_URL=rtsp://user:pass@192.168.1.104:554/stream1
CAM_05_URL=rtsp://user:pass@192.168.1.105:554/stream1

# --- YOLO / vision ---
YOLO_MODEL_PATH=yolov8n.pt
YOLO_CONFIDENCE=0.5
YOLO_IOU=0.45
YOLO_DEVICE=auto            # auto | cpu | 0
# FIRE_SMOKE_MODEL_PATH=fire_smoke_yolov8n.pt
POSE_MODEL_PATH=yolov8n-pose.pt

# --- Face recognition ---
FACE_RECOGNITION_TOLERANCE=0.45
FACE_RECOGNITION_MODEL=hog  # hog | cnn

# --- Alerts ---
ALERT_COOLDOWN_SECONDS=10
HIGH_PRIORITY_ESCALATION_COOLDOWN=60
MULTI_FACTOR_WINDOW_SECONDS=8

# --- Storage ---
MAX_STORAGE_GB=500
CLEANUP_DAYS=7
FREE_SPACE_THRESHOLD_PERCENT=80

# --- Processing ---
FRAME_SKIP_FACTOR=3
TARGET_PROCESSING_FPS=10
RECORDING_FPS=30
STREAM_JPEG_QUALITY=70

# --- Dashboard ---
DASHBOARD_HOST=0.0.0.0
DASHBOARD_PORT=5000
DASHBOARD_PASSWORD=admin123
DASHBOARD_AUTH_MODE=session   # session | basic

# --- System health ---
HEARTBEAT_URL=              # external watchdog ping URL (empty = disabled)
HEARTBEAT_INTERVAL=60
GEOFENCE_ROUTER_IP=192.168.1.1
ARMED_BY_DEFAULT=true
